{
  "manifest_version": 3,
  "name": "秋招智能填表助手",
  "version": "0.14.3",
  "description": "跨站扫描和填写招聘网页，使用用户配置的 AI 分析岗位匹配度，不自动提交。",
  "permissions": [
    "activeTab",
    "alarms",
    "background",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "秋招智能填表助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
